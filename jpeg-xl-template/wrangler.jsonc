/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jpeg-xl-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	// Makes the JPEG XL copies before every `wrangler dev` and `wrangler deploy`.
	"build": {
		"command": "npm run build"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		// The Worker runs only for pictures. Every other file is served straight from the assets.
		"run_worker_first": [
			"/*.jpg",
			"/*.jpeg",
			"/*.png",
			"/*.JPG",
			"/*.JPEG",
			"/*.PNG"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
