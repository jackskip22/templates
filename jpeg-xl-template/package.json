{
	"name": "jpeg-xl-template",
	"description": "Serve your site's JPEGs and PNGs as JPEG XL to browsers that accept it: smaller, with no loss, made when the site is built.",
	"cloudflare": {
		"label": "JPEG XL Images",
		"products": [
			"Workers",
			"Workers Static Assets"
		],
		"categories": [
			"starter"
		],
		"docs_url": "https://developers.cloudflare.com/workers/static-assets/"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.3",
		"@cloudflare/workers-types": "^5.20261102.1",
		"@vitest/runner": "4.1.10",
		"@vitest/snapshot": "4.1.10",
		"jpegxl": "8.4.1",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"build": "node scripts/build.mjs",
		"cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime false",
		"check": "tsc --noEmit && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "npm run build && vitest run"
	},
	"type": "module"
}
